      "date": "2026-07-25",
      "highlights": [
        { "description": "Module renamed to `github.com/grokify/go-atlassian`; root and `rest` packages consolidated into a single `jira` sub-package to support a multi-product Atlassian architecture" },
        { "description": "New `confluence` package with a Confluence REST API client and Storage Format IR (parse, render, validate)" },
        { "description": "New `report` package: configurable report engine with template-based rendering and export formats" },
