        { "description": "`--show-duplicates` flag on `fields` command to detect ambiguous field names", "commit": "7ec862a" },
        { "description": "`confluence` package: Confluence REST API client with Storage Format IR for parsing, rendering, and validating content", "commit": "78e6034" },
        { "description": "`report` package: configurable report engine with template-based rendering, section processors, and export formats for Jira issue data", "commit": "d5be7f2" },
        { "description": "CLI commands for Agile workflows: `boards`, `sprints`, `sprint-issues`, `sprint-move`, `velocity`, `burndown`, `cycle-time`, `worklog`, `transition`, `transitions`, `bulk-transition`, `clone`, `bulk-update`, `link`, `issue-types`, `report`", "commit": "5862748" },
        { "description": "`jira` package board service, `clone`, `webhook`, and `workflow` capabilities", "commit": "7f1c04a" },
        { "description": "Createmeta validation support in `core` package", "commit": "7f1c04a" },
        { "description": "MCP server expanded to 18 tools covering board, sprint, and reporting operations", "commit": "7f1c04a" },
        { "description": "Output format support for TOON, CSV, Markdown, and table rendering", "commit": "7f1c04a" }
